{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "node ./scripts/sync-data.mjs"
    ]
  },
  "hosting": {
    "site": "hubsy-widget",
    "public": "widget",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "predeploy": [
      "node ./scripts/sync-widget.mjs"
    ]
  }
}
