rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /videos/{videoId} {
      allow read: if resource.data.status == 'ready'
        || (signedIn() && resource.data.authorUid == request.auth.uid)
        || isAdmin();

      // Video docs are created and finalised by Cloud Functions (admin SDK) for
      // the Mux upload path, or directly by signed-in clients for external
      // links and for uploaded clips hosted on Cloudinary (short delivery URL
      // in mp4Url).
      allow create: if signedIn()
        && request.resource.data.status == 'ready'
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.flagged == false
        && (
          (
            request.resource.data.sourceType == 'external'
            && request.resource.data.platform in ['youtube', 'tiktok', 'instagram', 'linkedin']
            && request.resource.data.originalUrl is string
            && request.resource.data.embedUrl is string
          )
          ||
          (
            request.resource.data.sourceType == 'upload'
            && request.resource.data.platform == 'curio'
            && request.resource.data.mp4Url is string
            && request.resource.data.mp4Url.size() > 0
            && request.resource.data.mp4Url.size() <= 4096
          )
        );
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount']);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
          && (resource.data.authorUid == request.auth.uid || isAdmin());
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }

      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if signedIn() && uid == request.auth.uid;
        allow update: if false;
      }
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && uid == request.auth.uid;

      match /saves/{videoId} {
        allow read, write: if signedIn() && uid == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow create, update, delete: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
