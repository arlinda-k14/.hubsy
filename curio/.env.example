# Cloudinary *unsigned* upload config. These two values are public - the browser
# sends them with every upload and they ship in the client bundle - so they are
# safe to keep in the repo. Create a free account at https://cloudinary.com,
# then:
#   1. Copy "Cloud name" from your Cloudinary dashboard.
#   2. Settings -> Upload -> Upload presets -> Add upload preset.
#      Set "Signing Mode" to "Unsigned" and save. Copy the preset name.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
